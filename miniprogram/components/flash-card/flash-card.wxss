.flash-card-wrapper {
  width: 100%;
  height: 800rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.flash-card {
  width: 90%;
  height: 100%;
  background: linear-gradient(145deg, #1e293b 0%, #0f172a 50%, #1e293b 100%);
  border-radius: 32rpx;
  border: 2rpx solid rgba(56, 189, 248, 0.2);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5), 0 0 40rpx rgba(56, 189, 248, 0.1);
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

.flash-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 30%, rgba(56, 189, 248, 0.08) 0%, transparent 50%);
  pointer-events: none;
}

.swipe-hint {
  position: absolute;
  top: 60rpx;
  padding: 12rpx 32rpx;
  border-radius: 16rpx;
  border: 4rpx solid;
  z-index: 10;
  transition: opacity 0.15s;
}

.swipe-hint.left {
  left: 40rpx;
  border-color: var(--danger);
  background: rgba(248, 113, 113, 0.15);
}

.swipe-hint.right {
  right: 40rpx;
  border-color: var(--success);
  background: rgba(74, 222, 128, 0.15);
}

.hint-text {
  font-size: 36rpx;
  font-weight: 700;
}

.swipe-hint.left .hint-text {
  color: var(--danger);
}

.swipe-hint.right .hint-text {
  color: var(--success);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 2;
}

.category-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: rgba(56, 189, 248, 0.15);
  color: var(--primary);
  font-size: 24rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.audio-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(56, 189, 248, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.audio-btn:active {
  background: rgba(56, 189, 248, 0.3);
  transform: scale(0.95);
}

.audio-icon {
  font-size: 32rpx;
}

.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.term {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.abbr {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 16rpx;
  background: rgba(56, 189, 248, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.phonetic-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.phonetic {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-style: italic;
  font-family: 'Times New Roman', serif;
}

.translation {
  font-size: 40rpx;
  color: var(--primary);
  font-weight: 600;
  text-align: center;
}

.card-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 2;
}

.hint {
  font-size: 24rpx;
  color: var(--text-muted);
}

.swipe-guide {
  display: flex;
  justify-content: space-between;
  width: 100%;
  padding: 0 20rpx;
}

.guide-left,
.guide-right {
  font-size: 24rpx;
  color: var(--text-muted);
}

.guide-left {
  color: var(--danger);
}

.guide-right {
  color: var(--success);
}
