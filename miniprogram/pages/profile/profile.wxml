<view class="container">
  <!-- 用户信息 -->
  <view class="user-card" bindtap="{{userInfo ? '' : 'onTapGetUserInfo'}}">
    <image class="avatar" src="{{userInfo ? userInfo.avatarUrl : '/assets/icons/default-avatar.png'}}" mode="aspectFill"/>
    <view class="user-info">
      <text class="nickname">{{userInfo ? userInfo.nickName : '点击登录'}}</text>
      <text class="user-meta" wx:if="{{userInfo}}">已连续学习 {{streakDays}} 天</text>
      <text class="user-meta" wx:else>登录后可同步学习记录</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 快捷数据 -->
  <view class="quick-stats">
    <view class="quick-item" bindtap="onTapLearned">
      <text class="quick-value">{{progress ? progress.learned : 0}}</text>
      <text class="quick-label">已学习</text>
    </view>
    <view class="quick-item" bindtap="onTapReview">
      <text class="quick-value">{{progress ? progress.reviewing : 0}}</text>
      <text class="quick-label">待复习</text>
    </view>
    <view class="quick-item">
      <text class="quick-value">{{progress ? progress.progressPercent : 0}}%</text>
      <text class="quick-label">完成度</text>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="settings-card">
    <text class="settings-title">⚙️ 设置</text>

    <view class="setting-item" bindtap="onTapSetting" data-type="goal">
      <text class="setting-label">每日目标</text>
      <view class="setting-value">
        <text>{{settings ? settings.dailyGoal : 10}} 张/天</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="setting-item" bindtap="onTapSetting" data-type="reminder">
      <text class="setting-label">学习提醒</text>
      <view class="setting-value">
        <text class="toggle {{settings && settings.reminder ? 'active' : ''}}">
          {{settings && settings.reminder ? '开启' : '关闭'}}
        </text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="setting-item" bindtap="onTapSetting" data-type="sound">
      <text class="setting-label">音效</text>
      <view class="setting-value">
        <text class="toggle {{settings && settings.sound ? 'active' : ''}}">
          {{settings && settings.sound ? '开启' : '关闭'}}
        </text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 更多 -->
  <view class="settings-card">
    <text class="settings-title">📋 更多</text>

    <view class="setting-item" bindtap="onTapAbout">
      <text class="setting-label">关于</text>
      <view class="setting-value">
        <text class="arrow">›</text>
      </view>
    </view>

    <button class="setting-item share-btn" open-type="share">
      <text class="setting-label">分享给好友</text>
      <view class="setting-value">
        <text class="arrow">›</text>
      </view>
    </button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>AI学习卡片 v1.0.0</text>
  </view>
</view>
