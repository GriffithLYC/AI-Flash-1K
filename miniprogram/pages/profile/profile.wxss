.user-card {
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(56, 189, 248, 0.15);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(56, 189, 248, 0.3);
  background: var(--bg-card);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.user-meta {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.arrow {
  font-size: 40rpx;
  color: var(--text-muted);
}

.quick-stats {
  display: flex;
  justify-content: space-around;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.quick-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}

.quick-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.settings-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}

.settings-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: var(--text-primary);
}

.setting-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.toggle {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--border);
  color: var(--text-muted);
}

.toggle.active {
  background: rgba(56, 189, 248, 0.15);
  color: var(--primary);
}

.share-btn {
  background: none;
  border: none;
  padding: 24rpx 0;
  margin: 0;
  line-height: inherit;
  text-align: left;
  border-radius: 0;
}

.share-btn::after {
  border: none;
}

.version-info {
  text-align: center;
  padding: 30rpx 0 60rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}
