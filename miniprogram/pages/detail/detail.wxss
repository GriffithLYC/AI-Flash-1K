.detail-header {
  background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid rgba(56, 189, 248, 0.15);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-badges {
  display: flex;
  gap: 12rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.detail-term {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  line-height: 1.3;
}

.detail-abbr {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.detail-phonetic {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-style: italic;
  font-family: 'Times New Roman', serif;
  margin-bottom: 16rpx;
  display: block;
}

.detail-translation {
  font-size: 40rpx;
  color: var(--primary);
  font-weight: 600;
}

.detail-section {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.section-content {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.example-box {
  background: rgba(56, 189, 248, 0.08);
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 4rpx solid var(--primary);
}

.record-grid {
  display: flex;
  gap: 30rpx;
}

.record-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.record-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--primary);
}

.detail-actions {
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}
