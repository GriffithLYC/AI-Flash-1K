<view class="container">
  <view class="list-header">
    <text class="list-title">待复习卡片</text>
    <text class="list-count">共 {{count}} 张</text>
  </view>

  <view class="card-list" wx:if="{{cards.length > 0}}">
    <view class="list-item card-item"
          wx:for="{{cards}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapCard">
      <view class="item-info">
        <text class="item-term">{{item.term}}</text>
        <text class="item-translation">{{item.translation}}</text>
      </view>
      <view class="item-actions">
        <text class="category-tag">{{item.category}}</text>
        <view class="remove-btn" catchtap="onTapRemove" data-id="{{item.id}}">
          <text>移除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{cards.length === 0}}">
    <text class="empty-icon">📚</text>
    <text>暂无待复习卡片</text>
    <text class="empty-hint">学习时标记"不记得"的卡片会出现在这里</text>
    <view class="btn-primary empty-btn" bindtap="onTapStudy">开始学习</view>
  </view>
</view>
